{
  "name": "safefield",
  "private": true,
  "version": "0.1.0",
  "description": "Enterprise Field Worker Safety & Lone Worker Protection Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "worker:dev": "wrangler dev --config wrangler.toml",
    "worker:deploy": "wrangler deploy --config wrangler.toml",
    "db:local": "wrangler d1 migrations apply safefield-db --local --config wrangler.toml",
    "db:remote": "wrangler d1 migrations apply safefield-db --remote --config wrangler.toml",
    "scheduler:deploy": "wrangler deploy --config wrangler.scheduler.toml",
    "scheduler:dev": "wrangler dev --config wrangler.scheduler.toml"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "clsx": "^2.1.1",
    "hono": "^4.10.4",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8",
    "bcryptjs": "^3.0.2",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.45.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/leaflet": "^1.9.21"
  }
}
